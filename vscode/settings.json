{
    "chat.disableIFeatures": true,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.folding": false,
    "editor.fontFamily": "MesloLGLDZ Nerd Font",
    "editor.fontLigatures": true,
    "editor.fontSize": 15,
    "editor.inlineSuggest.enabled": false,
    "editor.inlineSuggest.showToolbar": "always",
    "editor.padding.bottom": 1,
    "editor.scrollBeyondLastLine": false,
    "editor.tabSize": 2,
    "editor.wordBasedSuggestions": "off",
    "editor.wordWrap": "on",
    "editor.wordWrapColumn": 120,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "git.openRepositoryInParentFolders": "never",
    "search.mode": "newEditor",
    "security.workspace.trust.untrustedFiles": "open",
    "terminal.integrated.fontFamily": "MesloLGLDZ Nerd Font",
    "terminal.integrated.defaultLocation": "editor",
    "terminal.integrated.enableFileLinks": "on",
    "terminal.integrated.fontSize": 16,
    "terminal.integrated.gpuAcceleration": "off",
    "vsicons.dontShowNewVersionMessage": true,
    "window.zoomLevel": 1,
    "workbench.activityBar.location": "hidden",
    "workbench.colorCustomizations": {
        "editor.background": "#1e1e1e",
        "editorLineNumber.foreground": "#888888",
        "editorGutter.background": "#2e2e2e",
        "breadcrumb.background": "#2e2e2e",
        "editorWidget.background": "#2e2e2e",
        "terminal.background": "#000000",
        "terminal.foreground": "#e4e4e4",
        "terminal.selectionBackground": "#303050",
        "terminal.selectionForeground": "#e4e4e4"
    },
    "workbench.iconTheme": "vscode-icons",
    "workbench.startupEditor": "none",
    "workbench.browser.showInTitleBar": true
}
