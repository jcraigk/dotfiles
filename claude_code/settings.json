{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "cctop@cctop": true,
    "claude-introspection@gusto-claude-code": true,
    "agent-skills@addy-agent-skills": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "gusto-claude-code": {
      "source": {
        "source": "github",
        "repo": "gusto/claude-code"
      }
    },
    "cctop": {
      "source": {
        "source": "github",
        "repo": "st0012/cctop"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "outputStyle": "explanatory",
  "alwaysThinkingEnabled": false,
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "normal",
  "preferredNotifChannel": "ghostty"
}
